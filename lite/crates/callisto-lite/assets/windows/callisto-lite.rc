// The executable's icon and version information (see build.rs).
#include <winres.h>

1 ICON ICON_PATH

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUMERIC
PRODUCTVERSION VERSION_NUMERIC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sahan S. Liyanage"
            VALUE "FileDescription", "e-CALLISTO FITS Analyzer Lite"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "InternalName", "callisto-lite"
            VALUE "LegalCopyright", "2026 Sahan S Liyanage, Astronomical and Space Science Unit, University of Colombo"
            VALUE "OriginalFilename", "callisto-lite.exe"
            VALUE "ProductName", "e-CALLISTO FITS Analyzer Lite"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
